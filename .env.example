# FinSight AI — Environment Variables
# Copy this to .env and fill in your real keys. NEVER commit .env.

# HuggingFace — free account at huggingface.co
# Accept Meta Llama license at huggingface.co/meta-llama/Llama-3.1-70B-Instruct
HUGGINGFACE_API_KEY=your_hf_token_here

# FRED API — free, unlimited at fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# LangSmith — free tier (5k traces/month) at smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=finsight-ai
