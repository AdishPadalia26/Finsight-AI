# FinSight AI — Environment Variables
# Copy this file to .env and fill in your real keys. NEVER commit .env.

# ── LLM Providers ────────────────────────────────────────────────────────────
# Each agent uses a dedicated API key to isolate rate limits across providers.

# Groq — Tier 1 (ProfileBuilder key 1, BehavioralPattern key 2) + ComplianceAgent key 3
# Also used as fallback for several Tier 2 agents.
# Get your keys at: console.groq.com/keys
GROQ_API_KEY_1=your_groq_key_1_here
GROQ_API_KEY_2=your_groq_key_2_here
GROQ_API_KEY_3=your_groq_key_3_here

# OpenRouter — BudgetArchitect key 1, InvestmentStrategist key 2, TaxIntelligence key 3
# Get your keys at: openrouter.ai/keys
OPENROUTER_API_KEY_1=your_openrouter_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_key_2_here
OPENROUTER_API_KEY_3=your_openrouter_key_3_here

# NVIDIA NIM — DebtElimination key 1, GoalEngineering key 2, LifeEventAgent key 1
# Get your keys at: build.nvidia.com
NVIDIA_API_KEY_1=your_nvidia_key_1_here
NVIDIA_API_KEY_2=your_nvidia_key_2_here

# Gemini — CriticAgent (primary) + PersonalisedAdvisor (primary); fallback for several agents
# Get your key at: aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ── Market Data ───────────────────────────────────────────────────────────────
# FRED API — free, no rate limits, no credit card required
# Used for: Fed funds rate, 10yr/3mo Treasury yields, CPI, BBB corporate bond spreads
# Register at: fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── LangSmith Tracing (optional) ─────────────────────────────────────────────
# Enables visual tracing of LangGraph execution at smith.langchain.com
# Free tier: 5k traces/month
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=finsight-ai

# ── Application ───────────────────────────────────────────────────────────────
# Secret key for request signing (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_in_production_32_char_min

# CORS allowed origins for the FastAPI backend (frontend origin)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend: base URL of the FastAPI backend (used for SSE and PDF report requests)
NEXT_PUBLIC_API_URL=http://localhost:8000
